{% extends 'base.html.twig' %}

{% block title %}{{ 'test_map.title'|trans }}{% endblock %}

{% block header %}
    {% set title = block('title') %}
    <twig:Layout:PageHeader :current="title" :breadcrumbs="[{label: 'layout.home'|trans, url: path('app_default')}]" />
{% endblock %}

{% block content %}
    <p class="page-intro">
        {{ 'test_map.intro'|trans }}<br>
        {{ 'test_map.intro_more'|trans }}
    </p>

    <div class="test-map-wrapper"
         data-controller="test-map test-datasets"
         data-test-datasets-url-value="{{ path('test_data_sets') }}"
         data-action="test-datasets:loaded->test-map#sources test-datasets:toggle->test-map#show">
        <div class="test-map" data-test-map-target="canvas"></div>

        <div class="test-map-panel">
            <twig:Button variant="secondary" size="sm" type="button"
                         data-bs-toggle="collapse" data-bs-target="#test-map-datasets"
                         aria-expanded="true" aria-controls="test-map-datasets">
                {{ 'test_map.models'|trans }}
            </twig:Button>
            <form id="test-map-datasets" class="test-map-datasets collapse show shadow-sm"
                  data-test-datasets-target="form" data-action="change->test-datasets#toggle"
                  aria-label="{{ 'test_map.models'|trans }}">
                <p class="test-map-loading" role="status" data-test-datasets-target="loading">
                    <span class="spinner-border" aria-hidden="true"></span>
                    {{ 'test_map.loading'|trans }}
                </p>
            </form>
        </div>
    </div>
{% endblock %}
