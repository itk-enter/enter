{% props source, entitiesUrl, history = null, totals = null, idle = false %}
{# One source on /sources. The closed card shows the title, the entities that came and went since the first import, #}
{# and the status of the last import. The open card adds the figures of the period and the facts about the source. #}
{# `history` is a SourceHistory, or null. `totals` is the {added, removed} of all the imports, or null. `idle` is true #}
{# if the history has no import of the source. `entitiesUrl` is the broker URL of the entities of the source. #}
{% set definition = source.definition %}
{% set last = history ? history.lastImport %}
{% set success = history ? history.lastSuccess %}
<twig:FoldCard :title="definition.title" id="{{ definition.id }}" :class="idle ? 'source-card-idle' : null">
    <twig:block name="summary">
        {% if history %}
            <span class="source-card-entities" title="{{ success ? 'source.card.entities_at'|trans({'%time%': success.startedAt|date('Y-m-d H:i')}) : 'source.card.no_success'|trans }}">
                <b>{{ success ? success.upserted|number_format : '–' }}</b> {{ 'source.card.entities'|trans }}
            </span>
            <span class="source-card-change" title="{{ 'source.card.change_title'|trans }}">
                <twig:Import:Change :count="totals.added ?? 0" sign="+" variant="added" />
                <twig:Import:Change :count="totals.removed ?? 0" sign="−" variant="removed" />
            </span>
            <span class="source-card-status">
                <span class="source-card-state"><twig:Import:Status :import="last" /></span>
                <span class="source-card-ago" title="{{ last.startedAt|date('Y-m-d H:i') }}">{{ 'source.card.ago'|trans({'%duration%': history.sinceLastImport|duration}) }}</span>
            </span>
        {% elseif idle %}
            <span class="source-card-status">{{ 'source.card.no_import'|trans }}</span>
        {% endif %}
    </twig:block>

    {% if history %}
        <div class="source-figures">
            {% if success and success.rejected %}
                <span class="source-figure"><b class="text-danger-emphasis">{{ success.rejected|number_format }}</b> {{ 'source.card.rejected'|trans }}</span>
            {% endif %}
            <span class="source-figure-period">{{ 'source.card.period'|trans({'%days%': history.days|length}) }}</span>
            <span class="source-figure">
                <b>{{ history.imports|length }}</b> {{ 'source.card.imports'|trans({'%count%': history.imports|length}) }}
                {%- if history.failed %}, <b class="text-danger-emphasis">{{ history.failed }}</b> {{ 'source.card.failed'|trans }}{% endif %}
            </span>
            {% if history.importInterval is not null %}
                <span class="source-figure"><b>{{ history.importInterval|duration }}</b> {{ 'source.card.interval'|trans }}</span>
            {% endif %}
            <span class="source-figure" title="{{ history.lastDataChange ? 'source.card.last_change'|trans({'%time%': history.lastDataChange.startedAt|date('Y-m-d H:i')}) : 'source.card.no_change'|trans }}">
                <b>{{ history.dataChanges }}</b> {{ 'source.card.data_changes'|trans({'%count%': history.dataChanges}) }}
            </span>
            {% if history.busiestDay > 0 %}
                <span class="source-figure source-figure-chart">
                    <twig:Source:HistoryChart :history="history" compact />
                </span>
            {% endif %}
            <twig:Button variant="secondary" size="sm" href="{{ path('app_source_show', {id: definition.id}) }}" class="source-figure-link">{{ 'source.card.history'|trans }}</twig:Button>
        </div>
        {% if last.failure %}
            <p class="source-card-failure">{{ last.failure }}</p>
        {% endif %}
    {% endif %}

    <dl class="fold-card-facts source-facts">
        <dt>{{ 'facts.id'|trans }}</dt>
        <dd><code>{{ definition.id }}</code></dd>

        {% if definition.description %}
            <dt>{{ 'facts.description'|trans }}</dt>
            <dd>{{ definition.description }}</dd>
        {% endif %}

        {% if definition.publisher %}
            <dt>{{ 'facts.publisher'|trans }}</dt>
            <dd>{{ definition.publisher }}</dd>
        {% endif %}

        {% if definition.contact %}
            <dt>{{ 'facts.contact'|trans }}</dt>
            <dd>{{ definition.contact }}</dd>
        {% endif %}

        {% if definition.landingPage %}
            <dt>{{ 'facts.landing_page'|trans }}</dt>
            <dd><a href="{{ definition.landingPage }}">{{ definition.landingPage }}</a></dd>
        {% endif %}

        <dt>{{ 'facts.access_url'|trans }}</dt>
        <dd>
            <a href="{{ definition.accessUrlBase }}">{{ definition.accessUrlBase }}</a>
            {% if definition.accessUrlQuery %}
                <pre class="mt-2 mb-0">{{ definition.accessUrlQuery|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
            {% endif %}
        </dd>

        <dt>{{ 'facts.data_type'|trans }}</dt>
        <dd>{{ definition.dataType.value }} ({{ definition.mediaType }}, {{ definition.crs }})</dd>

        <dt>{{ 'facts.model'|trans }}</dt>
        <dd><twig:Source:ModelLink :model="definition.model" :url="definition.modelUrl" /></dd>

        <dt>{{ 'facts.context'|trans }}</dt>
        <dd><a href="{{ definition.contextUrl }}">{{ definition.contextUrl }}</a></dd>

        <dt>{{ 'facts.entities'|trans }}</dt>
        <dd><a href="{{ entitiesUrl }}">{{ entitiesUrl }}</a></dd>

        {% if definition.updateFrequency %}
            <dt>{{ 'facts.update_frequency'|trans }}</dt>
            <dd>{{ definition.updateFrequency }}</dd>
        {% endif %}

        {% if definition.licence %}
            <dt>{{ 'facts.licence'|trans }}</dt>
            <dd><a href="{{ definition.licence }}">{{ definition.licence }}</a></dd>
        {% endif %}

        {% if definition.omittedFields %}
            <dt>{{ 'facts.omitted_fields'|trans }}</dt>
            <dd>
                <dl class="mb-0">
                    {% for field, reason in definition.omittedFields %}
                        <dt><code>{{ field }}</code></dt>
                        <dd>{{ reason }}</dd>
                    {% endfor %}
                </dl>
            </dd>
        {% endif %}
    </dl>
</twig:FoldCard>
