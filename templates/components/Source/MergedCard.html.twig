{% props dataSet, entitiesUrl %}
{# One merged data set on /sources. The closed card shows the title and the number of data sets that the merge reads. #}
{# The open card adds a link to the conflicts of the merge, and the facts about the merged data set. `dataSet` is a #}
{# MergedDataSet. `entitiesUrl` is the broker URL of its entities. #}
<twig:FoldCard :title="dataSet.title" id="{{ dataSet.id }}">
    <twig:block name="summary">
        <span class="source-card-status">
            Merged from {{ dataSet.inputs|length }} {{ dataSet.inputs|length == 1 ? 'data set' : 'data sets' }}
        </span>
    </twig:block>

    <div class="source-figures">
        <twig:Button variant="secondary" size="sm" href="{{ path('app_source_show', {id: dataSet.id}) }}" class="source-figure-link">Conflicts</twig:Button>
    </div>

    <dl class="fold-card-facts source-facts">
        <dt>Id</dt>
        <dd><code>{{ dataSet.id }}</code></dd>

        <dt>Description</dt>
        <dd>{{ dataSet.description }}</dd>

        <dt>Merged from</dt>
        <dd>
            {% for input in dataSet.inputs %}
                <code>{{ input }}</code>{% if not loop.last %}, {% endif %}
            {% else %}
                No data set publishes its models.
            {% endfor %}
        </dd>

        <dt>Model</dt>
        <dd><twig:Source:ModelLink :model="dataSet.model" :url="dataSet.modelUrl" /></dd>

        <dt>Context</dt>
        <dd><a href="{{ dataSet.contextUrl }}">{{ dataSet.contextUrl }}</a></dd>

        <dt>Entities</dt>
        <dd><a href="{{ entitiesUrl }}">{{ entitiesUrl }}</a></dd>

        {% if dataSet.licence %}
            <dt>Licence</dt>
            <dd><a href="{{ dataSet.licence }}">{{ dataSet.licence }}</a></dd>
        {% endif %}
    </dl>
</twig:FoldCard>
