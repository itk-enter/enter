{% props history, compact = false %}
{# The entities that the imports of a source added and removed each day. `history` is a SourceHistory. With `compact`, #}
{# the chart is small and has no legend, scale or dates. #}
{% set busiest = history.busiestDay %}
{% set first = history.days|first %}
{% set last = history.days|last %}
<div class="import-chart{{ compact ? ' import-chart-compact' }}">
    {% if not compact %}
        <div class="import-chart-legend small mb-1">
            <span><twig:Import:Swatch type="added" />{{ 'import.added'|trans }}</span>
            <span><twig:Import:Swatch type="removed" />{{ 'import.removed'|trans }}</span>
        </div>
    {% endif %}
    <div class="import-chart-plot">
        {% if not compact %}
            <div class="import-chart-scale small" aria-hidden="true">
                <span>+{{ busiest|number_format }}</span>
                <span>0</span>
                <span>−{{ busiest|number_format }}</span>
            </div>
        {% endif %}
        <div
            class="import-chart-days"
            style="--import-chart-day-count: {{ history.days|length }}"
            role="img"
            aria-label="{{ 'history.chart.label'|trans({'%added%': history.added, '%removed%': history.removed, '%from%': first.date|date('Y-m-d'), '%to%': last.date|date('Y-m-d')}) }}"
        >
            {% for day in history.days %}
                <div
                    class="import-chart-day"
                    title="{{ 'history.chart.day'|trans({'%date%': day.date|date('Y-m-d'), '%added%': day.added, '%removed%': day.removed, '%count%': day.imports}) }}"
                >
                    <div class="import-chart-up">
                        {% if day.added > 0 %}
                            <div class="import-chart-bar import-swatch-added" style="height: {{ (day.added / busiest * 100)|round(1) }}%"></div>
                        {% endif %}
                    </div>
                    <div class="import-chart-down">
                        {% if day.removed > 0 %}
                            <div class="import-chart-bar import-swatch-removed" style="height: {{ (day.removed / busiest * 100)|round(1) }}%"></div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% if not compact %}
        <div class="import-chart-axis small" aria-hidden="true">
            <span>{{ first.date|date('j/n') }}</span>
            <span>{{ last.date|date('j/n') }}</span>
        </div>
    {% endif %}
</div>
