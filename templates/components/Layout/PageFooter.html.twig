{# The footer at the bottom of each page, with links to the main pages and to the source code. #}
<footer {{ attributes.defaults({class: 'page-footer'}) }}>
    <div class="container-fluid page-footer-content">
        <a class="page-footer-logo" href="{{ path('app_default') }}">
            <img src="{{ asset('images/enter-logo.png') }}" alt="Enter" width="600" height="212">
        </a>
        <nav class="page-footer-links" aria-label="{{ 'layout.footer'|trans }}">
            <a href="{{ path('app_sources') }}">{{ 'sources.title'|trans }}</a>
            <a href="{{ path('app_default', {path: 'api'}) }}">{{ 'api.title'|trans }}</a>
            {% if 'dev' == app.environment %}
                <a href="{{ path('test_default') }}">{{ 'test_map.title'|trans }}</a>
            {% endif %}
            <a href="https://github.com/itk-enter/enter">{{ 'layout.source_code'|trans }}</a>
        </nav>
    </div>
</footer>
