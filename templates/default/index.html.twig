{% extends 'base.html.twig' %}

{% block header %}
    {% set title = block('title') %}
    <twig:Layout:PageHeader :current="title" />
{% endblock %}

{% block content %}
    <nav class="link-boxes" aria-label="Pages">
        <twig:LinkCard href="{{ path('app_sources') }}" title="Data sources">Data sets, sources and import history</twig:LinkCard>
        <twig:LinkCard href="{{ path('app_default', {path: 'api'}) }}" title="API">Example requests to the NGSI-LD API</twig:LinkCard>
        {% if 'dev' == app.environment %}
            <twig:LinkCard href="{{ path('test_default') }}" title="Test map">View data sets on a map</twig:LinkCard>
        {% endif %}
    </nav>
{% endblock %}
