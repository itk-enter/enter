{% extends 'base.html.twig' %}

{% block header %}
    {% set title = block('title') %}
    <twig:Layout:PageHeader :current="title" />
{% endblock %}

{% block content %}
    <nav class="link-boxes" aria-label="{{ 'home.pages'|trans }}">
        <twig:LinkCard href="{{ path('app_sources') }}" title="{{ 'sources.title'|trans }}">{{ 'home.sources'|trans }}</twig:LinkCard>
        <twig:LinkCard href="{{ path('app_default', {path: 'api'}) }}" title="{{ 'api.title'|trans }}">{{ 'home.api'|trans }}</twig:LinkCard>
        {% if 'dev' == app.environment %}
            <twig:LinkCard href="{{ path('test_default') }}" title="{{ 'test_map.title'|trans }}">{{ 'home.test_map'|trans }}</twig:LinkCard>
        {% endif %}
    </nav>
{% endblock %}
