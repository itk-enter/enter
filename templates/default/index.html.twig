{% extends 'base.html.twig' %}

{% block header %}
    {{ include('_page_header.html.twig', {
        breadcrumbs: [],
        current: block('title'),
        logo: asset('images/enter-logo.png'),
    }) }}
{% endblock %}

{% block content %}
    <nav class="link-boxes" aria-label="Pages">
        <a class="link-box" href="{{ path('app_sources') }}">
            <span class="link-box-title">Data sources</span>
            <span class="link-box-text">Data sets, sources and import history</span>
        </a>
        <a class="link-box" href="{{ path('app_default', {path: 'api'}) }}">
            <span class="link-box-title">API</span>
            <span class="link-box-text">Example requests to the NGSI-LD API</span>
        </a>
        {% if 'dev' == app.environment %}
            <a class="link-box" href="{{ path('test_default') }}">
                <span class="link-box-title">Test map</span>
                <span class="link-box-text">View data sets on a map</span>
            </a>
        {% endif %}
    </nav>
{% endblock %}
