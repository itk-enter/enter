{% extends 'base.html.twig' %}

{% set base = url('app_default')|trim('/', 'right') %}
{% set osm_bench = '/ngsi-ld/v1/entities?q=sourceId=="osm-bench"' %}

{% block title %}{{ 'api.title'|trans }}{% endblock %}

{% block header %}
    {% set title = block('title') %}
    <twig:Layout:PageHeader :current="title" :breadcrumbs="[{label: 'layout.home'|trans, url: path('app_default')}]" />
{% endblock %}

{% block content %}
    <p class="page-intro">
        {{ 'api.intro'|trans }}<br>
        {{ 'api.intro_more'|trans }}
    </p>

    <twig:Api:Endpoint path="/sources.json" :label="'api.sources.label'|trans">
        <p>{{ 'api.sources.text_html'|trans|raw }}</p>
        <twig:Api:Example :base="base" path="/sources.json">{{ 'api.sources.example'|trans }}</twig:Api:Example>
        <p class="fold-card-label">{{ 'api.response_shortened'|trans }}</p>
        <pre class="api-code"><code>[
  {
    "id": "osm-bench",
    "title": "Bænke (OpenStreetMap), Aarhus Kommune",
    "description": "Benches mapped in OpenStreetMap within Aarhus Municipality.",
    "publisher": "OpenStreetMap contributors",
    "model": "Bench",
    "context_url": "https://raw.githubusercontent.com/itk-enter/data-models/Bench/v0.0.1/dataModel.PointOfInterest/context.jsonld",
    "licence": "https://opendatacommons.org/licenses/odbl/1-0/",
    "entities_url": "{{ base }}/ngsi-ld/v1/entities?q=sourceId%3D%3D%22osm-bench%22",
    …
  },
  …
]</code></pre>
    </twig:Api:Endpoint>

    <twig:Api:Endpoint path="/ngsi-ld/v1/types" :label="'api.types.label'|trans">
        <p>{{ 'api.types.text'|trans }}</p>
        <twig:Api:Example :base="base" path="/ngsi-ld/v1/types">{{ 'api.types.example'|trans }}</twig:Api:Example>
        <p class="fold-card-label">{{ 'api.response'|trans }}</p>
        <pre class="api-code"><code>{
  "id": "urn:ngsi-ld:EntityTypeList:1795095971325",
  "type": "EntityTypeList",
  "typeList": [
    "https://itk-enter.github.io/data-models/dataModel.PointOfInterest/Bench",
    "https://smartdatamodels.org/dataModel.Parking/ParkingSpot",
    "https://smartdatamodels.org/dataModel.Parking/OffStreetParking",
    "https://itk-enter.github.io/data-models/dataModel.PointOfInterest/PublicToilet",
    "https://smartdatamodels.org/dataModel.Parking/OnStreetParking"
  ]
}</code></pre>
    </twig:Api:Endpoint>

    <twig:Api:Endpoint path="/ngsi-ld/v1/entities" :label="'api.entities.label'|trans">
        <p>{{ 'api.entities.text_html'|trans|raw }}</p>
        <p class="fold-card-label">{{ 'api.parameters'|trans }}</p>
        <dl class="fold-card-facts">
            <dt><code>type</code></dt>
            <dd>{{ 'api.entities.type'|trans }}</dd>

            <dt><code>q</code></dt>
            <dd>{{ 'api.entities.q_html'|trans|raw }}</dd>

            <dt><code>format=simplified</code></dt>
            <dd>{{ 'api.entities.simplified'|trans }}</dd>

            <dt><code>attrs</code></dt>
            <dd>{{ 'api.entities.attrs_html'|trans|raw }}</dd>

            <dt><code>limit</code>, <code>offset</code></dt>
            <dd>{{ 'api.entities.paging_html'|trans|raw }}</dd>

            <dt><code>count=true</code></dt>
            <dd>{{ 'api.entities.count_html'|trans|raw }}</dd>

            <dt><code>georel</code>, <code>geometry</code>, <code>coordinates</code></dt>
            <dd>{{ 'api.entities.near_html'|trans|raw }}</dd>
        </dl>
        <p class="fold-card-label">{{ 'api.headers'|trans }}</p>
        <dl class="fold-card-facts">
            <dt><code>Accept</code></dt>
            <dd>{{ 'api.entities.accept_html'|trans|raw }}</dd>

            <dt><code>Link</code></dt>
            <dd>{{ 'api.entities.link_html'|trans|raw }}</dd>
        </dl>
        <twig:Api:Example :base="base" :path="osm_bench ~ '&format=simplified&limit=1'">{{ 'api.entities.example'|trans }}</twig:Api:Example>
        <p class="fold-card-label">{{ 'api.response_shortened'|trans }}</p>
        <pre class="api-code"><code>[
  {
    "id": "urn:ngsi-ld:Bench:aarhus-bench-osm-node-14331600814",
    "type": "https://itk-enter.github.io/data-models/dataModel.PointOfInterest/Bench",
    "https://smartdatamodels.org/dataProvider": "OpenStreetMap contributors",
    "https://smartdatamodels.org/seeAlso": "https://www.openstreetmap.org/node/14331600814",
    "sourceId": "osm-bench",
    "location": {
      "type": "Point",
      "coordinates": [10.3324159, 56.232945]
    },
    …
  }
]</code></pre>
    </twig:Api:Endpoint>

    <twig:Api:Endpoint path="/ngsi-ld/v1/entities/{id}" :label="'api.entity.label'|trans">
        <p>{{ 'api.entity.text_html'|trans|raw }}</p>
        <twig:Api:Example :base="base" path="/ngsi-ld/v1/entities/urn:ngsi-ld:Bench:aarhus-bench-osm-node-14331600814">{{ 'api.entity.example'|trans }}</twig:Api:Example>
        <p class="fold-card-label">{{ 'api.response_shortened'|trans }}</p>
        <pre class="api-code"><code>{
  "id": "urn:ngsi-ld:Bench:aarhus-bench-osm-node-14331600814",
  "type": "https://itk-enter.github.io/data-models/dataModel.PointOfInterest/Bench",
  "https://smartdatamodels.org/dataProvider": {
    "type": "Property",
    "value": "OpenStreetMap contributors"
  },
  "sourceId": {
    "type": "Property",
    "value": "osm-bench"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [10.3324159, 56.232945]
    }
  },
  …
}</code></pre>
    </twig:Api:Endpoint>
{% endblock %}
