{#
    The footer at the bottom of each page, with links to the main pages and to the source code.
#}
<footer class="page-footer">
    <div class="container-fluid page-footer-content">
        <a class="page-footer-logo" href="{{ path('app_default') }}">
            <img src="{{ asset('images/enter-logo.png') }}" alt="Enter" width="600" height="212">
        </a>
        <nav class="page-footer-links" aria-label="Footer">
            <a href="{{ path('app_sources') }}">Data sources</a>
            <a href="{{ path('app_default', {path: 'api'}) }}">API</a>
            {% if 'dev' == app.environment %}
                <a href="{{ path('test_default') }}">Test map</a>
            {% endif %}
            <a href="https://github.com/itk-enter/enter">Source code on GitHub</a>
        </nav>
    </div>
</footer>
