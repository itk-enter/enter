{% extends 'base.html.twig' %}

{#
    The page of one merged data set: the conflicts of the last run of its merge.
    Variables: data_set (a MergedDataSet) and overview (a ConflictOverview, or null if the broker is not available).
#}

{% block title %}{{ data_set.title }}{% endblock %}

{% block header %}
    <twig:Layout:PageHeader
        :current="data_set.title"
        :breadcrumbs="[
            {label: 'layout.home'|trans, url: path('app_default')},
            {label: 'sources.title'|trans, url: path('app_sources') ~ '#' ~ data_set.id},
        ]"
    />
{% endblock %}

{% block content %}
    <p class="page-meta">
        <code>{{ data_set.id }}</code> · {{ 'facts.model'|trans }}
        <twig:Source:ModelLink :model="data_set.model" :url="data_set.modelUrl" />
        · {{ 'merged.from'|trans({'%count%': data_set.inputs|length}) }}
    </p>

    <p class="page-intro">
        {{ 'merged.intro_html'|trans|raw }}
    </p>

    {% if overview is null %}
        <p class="text-body-secondary">{{ 'merged.broker_unavailable'|trans }}</p>
    {% elseif overview.entities is empty %}
        <div class="conflict-summary">
            <twig:Tag variant="success">{{ 'merged.no_conflicts'|trans }}</twig:Tag>
            <span>{{ 'merged.all_settled'|trans }}</span>
        </div>
    {% else %}
        {% set attributeCounts = overview.attributes %}
        {% set entities = overview.entities %}
        <div class="conflict-summary">
            <twig:Tag variant="warning">{{ 'merged.conflicts'|trans({'%count%': entities|length}) }}</twig:Tag>
            <span><b>{{ entities|length|number_format }}</b> {{ 'merged.entities_in_conflict'|trans({'%count%': entities|length}) }}</span>
            <span><b>{{ attributeCounts|length }}</b> {{ 'merged.attributes_in_conflict'|trans({'%count%': attributeCounts|length}) }}</span>
        </div>

        <div class="row g-4">
            <div class="col-xl-7">
                <twig:Heading level="2" size="md">{{ 'merged.map.title'|trans }}</twig:Heading>
                <div
                    class="conflict-map"
                    data-controller="conflict-map"
                    data-conflict-map-features-value="{{ overview.featureCollection|json_encode }}"
                    role="region"
                    aria-label="{{ 'merged.map.label'|trans }}"
                ></div>
                <p class="small text-body-secondary mt-1">{{ 'merged.map.help'|trans }}</p>
            </div>

            <div class="col-xl-5">
                <twig:Heading level="2" size="md">{{ 'merged.attributes.title'|trans }}</twig:Heading>
                <p class="small text-body-secondary">{{ 'merged.attributes.help'|trans }}</p>
                <twig:Conflict:Bars :counts="attributeCounts" :total="entities|length" />

                <twig:Heading level="2" size="md" class="mt-4">{{ 'merged.data_sets.title'|trans }}</twig:Heading>
                <p class="small text-body-secondary">{{ 'merged.data_sets.help'|trans }}</p>
                <twig:Conflict:Bars
                    :counts="overview.dataSets"
                    :total="attributeCounts|reduce((sum, count) => sum + count, 0)"
                    :labels="overview.dataSetTitles"
                />
            </div>
        </div>

        <twig:Heading level="2" size="md" class="mt-4">{{ 'merged.entities.title'|trans }}</twig:Heading>
        {% for number, entity in entities %}
            <twig:FoldCard :title="entity.title" id="conflict-{{ number }}" class="conflict-entity">
                <twig:block name="summary">
                    <span class="source-card-status">
                        {% for attribute in entity.conflicts|keys %}
                            <code>{{ attribute }}</code>
                        {% endfor %}
                    </span>
                </twig:block>

                <p class="small text-body-secondary"><code class="text-break">{{ entity.id }}</code></p>
                <dl class="fold-card-facts">
                    {% for attribute, values in entity.conflicts %}
                        <dt><code>{{ attribute }}</code></dt>
                        <dd>
                            <ul class="list-unstyled mb-0 conflict-values">
                                {% for stated in values %}
                                    <li>
                                        <b>{{ stated.value|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</b>
                                        {{ 'merged.entities.from'|trans({'%data_set%': overview.dataSetTitle(stated.dataSet)}) }}
                                        <span class="conflict-record" title="{{ 'merged.entities.record'|trans }}">{{ stated.entity }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </dd>
                    {% endfor %}
                </dl>
            </twig:FoldCard>
        {% endfor %}
    {% endif %}
{% endblock %}
