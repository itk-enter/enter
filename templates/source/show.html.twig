{% extends 'base.html.twig' %}

{% block title %}{{ source.definition.title }}{% endblock %}

{% block header %}
    <twig:Layout:PageHeader
        :current="source.definition.title"
        :breadcrumbs="[
            {label: 'layout.home'|trans, url: path('app_default')},
            {label: 'sources.title'|trans, url: path('app_sources') ~ '#' ~ source.definition.id},
        ]"
    />
{% endblock %}

{% block content %}
    {% set definition = source.definition %}
    <p class="page-meta">
        <code>{{ definition.id }}</code> · {{ 'facts.model'|trans }}
        <twig:Source:ModelLink :model="definition.model" :url="definition.modelUrl" />
    </p>

    {% if histories is null %}
        <p class="text-body-secondary">{{ 'history.unavailable'|trans }}</p>
    {% else %}
        <twig:Source:HistorySummary :history="history" />

        {% if history %}
            <p class="small text-body-secondary">
                {{ 'history.intro'|trans({'%days%': history.days|length}) }}
            </p>

            <div class="row g-4">
                <div class="col-xl-7">
                    <twig:Heading level="2" size="md" id="import-days">{{ 'history.days'|trans }}</twig:Heading>
                    {% if history.busiestDay > 0 %}
                        <twig:Source:HistoryChart :history="history" />
                    {% else %}
                        <p class="text-body-secondary mb-0">{{ 'history.no_entities_moved'|trans({'%days%': history.days|length}) }}</p>
                    {% endif %}

                    <details class="mt-2 mb-4">
                        <summary class="small">{{ 'history.table.show'|trans }}</summary>
                        <twig:Table labelledby="import-days" class="import-table">
                            <thead>
                                <tr>
                                    <th scope="col">{{ 'history.table.day'|trans }}</th>
                                    <th scope="col" class="text-end">{{ 'history.table.imports'|trans }}</th>
                                    <th scope="col" class="text-end">{{ 'history.table.failed'|trans }}</th>
                                    <th scope="col" class="text-end">{{ 'import.added'|trans }}</th>
                                    <th scope="col" class="text-end">{{ 'import.removed'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for day in history.days|reverse|filter(day => day.imports > 0) %}
                                    <tr>
                                        <td><twig:Time :date="day.date" dateOnly /></td>
                                        <td class="text-end">{{ day.imports }}</td>
                                        <td class="text-end">{{ day.failed ?: '' }}</td>
                                        <td class="text-end"><twig:Import:Change :count="day.added" sign="+" /></td>
                                        <td class="text-end"><twig:Import:Change :count="day.removed" sign="−" /></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </twig:Table>
                    </details>

                    <twig:Heading level="2" size="md">{{ 'history.events.title'|trans }}</twig:Heading>
                    {% set imports = history.events(events) %}
                    {% if imports %}
                        <ol class="import-timeline">
                            {% for import in imports %}
                                <li class="import-timeline-item import-timeline-{{ import.status.value }}">
                                    <div class="import-timeline-head">
                                        <twig:Time :date="import.startedAt" />
                                        <twig:Import:Status :import="import" />
                                        {% if import.fullLoad %}<twig:Tag variant="neutral">{{ 'history.events.full_load'|trans }}</twig:Tag>{% endif %}
                                    </div>
                                    {% if import.succeeded %}
                                        <div class="import-timeline-body">
                                            {% if import.added %}
                                                <span><twig:Import:Swatch type="added" />{{ 'history.events.added'|trans({'%number%': import.added|number_format}) }}</span>
                                            {% endif %}
                                            {% if import.removed %}
                                                <span><twig:Import:Swatch type="removed" />{{ 'history.events.removed'|trans({'%number%': import.removed|number_format}) }}</span>
                                            {% endif %}
                                            {% if history.changedData(import) %}
                                                <span>{{ 'history.events.changed'|trans }}</span>
                                            {% endif %}
                                            <span class="text-body-secondary">
                                                {{ 'history.events.entities'|trans({'%number%': import.upserted|number_format}) }}
                                                {%- if import.rejected %}, {{ 'history.events.rejected'|trans({'%number%': import.rejected|number_format}) }}{% endif %}
                                                · {{ import.duration|duration }}
                                            </span>
                                        </div>
                                    {% elseif import.failure %}
                                        <div class="import-timeline-body small text-break">{{ import.failure }}</div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% else %}
                        <p class="text-body-secondary">{{ 'history.events.none'|trans({'%days%': history.days|length}) }}</p>
                    {% endif %}
                </div>

                <div class="col-xl-5">
                    <twig:Heading level="2" size="md">{{ 'history.changes.title'|trans }}</twig:Heading>
                    {% if changes %}
                        <ul class="list-group list-group-flush import-changes">
                            {% for change in changes %}
                                <li class="list-group-item">
                                    <twig:Import:Swatch :type="change.type.value" />
                                    <code class="text-break">{{ change.entityId }}</code>
                                    <span class="import-changes-time">{{ ('history.changes.' ~ change.type.value)|trans }} <twig:Time :date="change.sourceImport.startedAt" /></span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-body-secondary">{{ 'history.changes.none'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
