{% extends 'base.html.twig' %}

{% block title %}{{ source.definition.title }}{% endblock %}

{% block header %}
    <twig:Layout:PageHeader
        :current="source.definition.title"
        :breadcrumbs="[
            {label: 'Home', url: path('app_default')},
            {label: 'Data sources', url: path('app_sources') ~ '#' ~ source.definition.id},
        ]"
    />
{% endblock %}

{% block content %}
    {% set definition = source.definition %}
    <p class="page-meta">
        <code>{{ definition.id }}</code> · Model
        <twig:Source:ModelLink :model="definition.model" :url="definition.modelUrl" />
    </p>

    {% if histories is null %}
        <p class="text-body-secondary">The import history is not available.</p>
    {% else %}
        <twig:Source:HistorySummary :history="history" />

        {% if history %}
            <p class="small text-body-secondary">
                The figures count the last {{ history.days|length }} days. The data changed if the entities of an
                import are different from the entities of the import before it. A full load adds all the entities of
                the source. The figures and the chart do not count its added entities. All times are in Danish time.
            </p>

            <div class="row g-4">
                <div class="col-xl-7">
                    <twig:Heading level="2" size="md" id="import-days">Entities added and removed each day</twig:Heading>
                    {% if history.busiestDay > 0 %}
                        <twig:Source:HistoryChart :history="history" />
                    {% else %}
                        <p class="text-body-secondary mb-0">No entities came or went in the last {{ history.days|length }} days.</p>
                    {% endif %}

                    <details class="mt-2 mb-4">
                        <summary class="small">Show the days as a table</summary>
                        <twig:Table labelledby="import-days" class="import-table">
                            <thead>
                                <tr>
                                    <th scope="col">Day</th>
                                    <th scope="col" class="text-end">Imports</th>
                                    <th scope="col" class="text-end">Failed</th>
                                    <th scope="col" class="text-end">Added</th>
                                    <th scope="col" class="text-end">Removed</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for day in history.days|reverse|filter(day => day.imports > 0) %}
                                    <tr>
                                        <td><twig:Time :date="day.date" dateOnly /></td>
                                        <td class="text-end">{{ day.imports }}</td>
                                        <td class="text-end">{{ day.failed ?: '' }}</td>
                                        <td class="text-end"><twig:Import:Change :count="day.added" sign="+" /></td>
                                        <td class="text-end"><twig:Import:Change :count="day.removed" sign="−" /></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </twig:Table>
                    </details>

                    <twig:Heading level="2" size="md">Imports that changed something or failed</twig:Heading>
                    {% set imports = history.events(events) %}
                    {% if imports %}
                        <ol class="import-timeline">
                            {% for import in imports %}
                                <li class="import-timeline-item import-timeline-{{ import.status.value }}">
                                    <div class="import-timeline-head">
                                        <twig:Time :date="import.startedAt" />
                                        <twig:Import:Status :import="import" />
                                        {% if import.fullLoad %}<twig:Tag variant="neutral">Full load</twig:Tag>{% endif %}
                                    </div>
                                    {% if import.succeeded %}
                                        <div class="import-timeline-body">
                                            {% if import.added %}
                                                <span><twig:Import:Swatch type="added" />{{ import.added|number_format }} added</span>
                                            {% endif %}
                                            {% if import.removed %}
                                                <span><twig:Import:Swatch type="removed" />{{ import.removed|number_format }} removed</span>
                                            {% endif %}
                                            {% if history.changedData(import) %}
                                                <span>The data changed</span>
                                            {% endif %}
                                            <span class="text-body-secondary">
                                                {{ import.upserted|number_format }} entities
                                                {%- if import.rejected %}, {{ import.rejected|number_format }} rejected{% endif %}
                                                · {{ import.duration|duration }}
                                            </span>
                                        </div>
                                    {% elseif import.failure %}
                                        <div class="import-timeline-body small text-break">{{ import.failure }}</div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% else %}
                        <p class="text-body-secondary">No import changed something or failed in the last {{ history.days|length }} days.</p>
                    {% endif %}
                </div>

                <div class="col-xl-5">
                    <twig:Heading level="2" size="md">The last entities that came and went</twig:Heading>
                    {% if changes %}
                        <ul class="list-group list-group-flush import-changes">
                            {% for change in changes %}
                                <li class="list-group-item">
                                    <twig:Import:Swatch :type="change.type.value" />
                                    <code class="text-break">{{ change.entityId }}</code>
                                    <span class="import-changes-time">{{ change.type.value|capitalize }} <twig:Time :date="change.sourceImport.startedAt" /></span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-body-secondary">No import added or removed an entity.</p>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
