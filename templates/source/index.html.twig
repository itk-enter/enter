{% extends 'base.html.twig' %}

{% block title %}Data sets{% endblock %}

{% block header %}
    <header class="data-sets-header">
        <p class="data-sets-eyebrow">Enter · {{ block('title') }}</p>
        <h1 class="data-sets-title">Open data about Aarhus</h1>

        <div class="data-sets-facts">
            <span class="data-sets-fact"><b>{{ groups|length }}</b> {{ groups|length == 1 ? 'topic' : 'topics' }}</span>
            <span class="data-sets-fact"><b>{{ merged|length }}</b> merged data {{ merged|length == 1 ? 'set' : 'sets' }}</span>
            <span class="data-sets-fact"><b>{{ sources|length }}</b> {{ sources|length == 1 ? 'source' : 'sources' }}</span>
            <span class="data-sets-links">
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_sources', {_format: 'json'}) }}">List as JSON</a>
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('ngsi_ld_v1_request', {path: 'types'}) }}">Types in the broker</a>
            </span>
        </div>
    </header>
{% endblock %}

{% block content %}
    <p class="data-sets-about">
        We collect open data from many publishers. Where they describe the same things, we merge the data into one
        data set. The data models build on <a href="https://smartdatamodels.org/">Smart Data Models</a>, an open set of
        shared data models for cities. All data is served as NGSI-LD.
    </p>

    {% if histories is null %}
        <p class="text-body-secondary">The import history is not available.</p>
    {% endif %}

    {% for group in groups %}
        {% set imported = histories is null ? group.sources : group.sources|filter(source => histories[source.definition.id] is defined) %}
        {% set idle = histories is null ? [] : group.sources|filter(source => histories[source.definition.id] is not defined) %}
        {% set count = group.sources|length + group.merged|length %}

        <section class="source-group">
            <h2 class="source-group-title">
                {{ group.title }}
                <span class="source-group-count">{{ count }} {{ count == 1 ? 'data set' : 'data sets' }}</span>
            </h2>

            {% if group.merged %}
                <details class="source-part">
                    <summary class="source-part-summary">
                        <span>
                            {{ group.merged|length == 1 ? 'Merged data set' : 'Merged data sets' }}
                            <span class="source-group-count">{{ group.merged|length }}</span>
                        </span>
                    </summary>
                    {% for dataSet in group.merged %}
                        {{ include('source/_merged_card.html.twig', {
                            data_set: dataSet,
                            entities_url: entitiesUrls[dataSet.id],
                        }, with_context: false) }}
                    {% endfor %}
                </details>
            {% endif %}

            {% if group.sources %}
                <details class="source-part">
                    <summary class="source-part-summary">
                        <span>
                            {{ group.sources|length == 1 ? 'Source' : 'Sources' }}
                            <span class="source-group-count">{{ group.sources|length }}</span>
                        </span>
                    </summary>
                    {% for source in imported %}
                        {{ include('source/_source_card.html.twig', {
                            source: source,
                            history: histories[source.definition.id] ?? null,
                            idle: false,
                            entities_url: entitiesUrls[source.definition.id],
                        }, with_context: false) }}
                    {% endfor %}

                    {% for source in idle %}
                        {{ include('source/_source_card.html.twig', {
                            source: source,
                            history: null,
                            idle: true,
                            entities_url: entitiesUrls[source.definition.id],
                        }, with_context: false) }}
                    {% endfor %}
                </details>
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}
