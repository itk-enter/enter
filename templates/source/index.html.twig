{% extends 'base.html.twig' %}

{% block title %}Data sources{% endblock %}

{% block header %}
    {% set title = block('title') %}
    <twig:Layout:PageHeader :current="title" :breadcrumbs="[{label: 'Home', url: path('app_default')}]" />
{% endblock %}

{% block content %}
    <p class="page-intro">
        Browse the data sets in the broker, grouped by topic.<br>
        Open a data set to see its source, its import history and the link to its entities.
    </p>

    {% if histories is null %}
        <p class="text-body-secondary">The import history is not available.</p>
    {% endif %}

    {% for group in groups %}
        {% set imported = histories is null ? group.sources : group.sources|filter(source => histories[source.definition.id] is defined) %}
        {% set idle = histories is null ? [] : group.sources|filter(source => histories[source.definition.id] is not defined) %}
        {% set count = group.sources|length + group.merged|length %}

        <section class="source-group">
            <twig:Heading level="2" class="source-group-title">
                {{ group.title }}
                <span class="source-group-count">{{ count }} {{ count == 1 ? 'data set' : 'data sets' }}</span>
            </twig:Heading>

            {% if group.merged %}
                <details class="source-part">
                    <summary class="source-part-summary">
                        <span>
                            {{ group.merged|length == 1 ? 'Merged data set' : 'Merged data sets' }}
                            <span class="source-group-count">{{ group.merged|length }}</span>
                        </span>
                    </summary>
                    {% for dataSet in group.merged %}
                        <twig:Source:MergedCard :dataSet="dataSet" :entitiesUrl="entitiesUrls[dataSet.id]" />
                    {% endfor %}
                </details>
            {% endif %}

            {% if group.sources %}
                <details class="source-part">
                    <summary class="source-part-summary">
                        <span>
                            {{ group.sources|length == 1 ? 'Source' : 'Sources' }}
                            <span class="source-group-count">{{ group.sources|length }}</span>
                        </span>
                    </summary>
                    {% for source in imported %}
                        <twig:Source:Card
                            :source="source"
                            :history="histories[source.definition.id] ?? null"
                            :totals="totals[source.definition.id] ?? null"
                            :entitiesUrl="entitiesUrls[source.definition.id]"
                        />
                    {% endfor %}

                    {% for source in idle %}
                        <twig:Source:Card :source="source" :entitiesUrl="entitiesUrls[source.definition.id]" idle />
                    {% endfor %}
                </details>
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}
