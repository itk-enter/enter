{% extends 'base.html.twig' %}

{% block title %}Sources{% endblock %}

{% block content %}
    <p>
        The data sets in the broker: the sources, and the merged data sets that the merges make from them. Each
        entity has a <code>sourceId</code> attribute with the id of its data set. Each data set below links to its
        entities in the broker.
        This list is also available as <a href="{{ path('app_sources', {_format: 'json'}) }}">JSON</a>.
    </p>

    {% if histories is null %}
        <p class="text-body-secondary">The import history is not available.</p>
    {% else %}
        <p>
            The data sets are grouped by the model of the merged data set. Each group starts with the merged data
            set, then the sources that it is merged from, also when their model is different. A source that no merge
            reads is in the group of its own model. The sources without an import come last. Each source shows its
            last import, and figures for the imports of the last
            {{ constant('App\\Import\\History\\ImportHistory::DAYS') }} days.
        </p>
    {% endif %}

    {% for group in groups %}
        {% set imported = histories is null ? group.sources : group.sources|filter(source => histories[source.definition.id] is defined) %}
        {% set idle = histories is null ? [] : group.sources|filter(source => histories[source.definition.id] is not defined) %}
        {% set count = group.sources|length + group.merged|length %}

        <h2 class="source-group">
            {{ group.title }}
            <span class="source-group-count">{{ count }} {{ count == 1 ? 'data set' : 'data sets' }}</span>
        </h2>

        {% for dataSet in group.merged %}
            {{ include('source/_merged_card.html.twig', {
                data_set: dataSet,
                entities_url: entitiesUrls[dataSet.id],
            }, with_context: false) }}
        {% endfor %}

        {% for source in imported %}
            {{ include('source/_source_card.html.twig', {
                source: source,
                history: histories[source.definition.id] ?? null,
                idle: false,
                entities_url: entitiesUrls[source.definition.id],
            }, with_context: false) }}
        {% endfor %}

        {% for source in idle %}
            {{ include('source/_source_card.html.twig', {
                source: source,
                history: null,
                idle: true,
                entities_url: entitiesUrls[source.definition.id],
            }, with_context: false) }}
        {% endfor %}
    {% endfor %}
{% endblock %}
