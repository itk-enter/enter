{% extends 'base.html.twig' %}

{% block title %}Sources{% endblock %}

{% block content %}
    <p>
        The data sets in the broker: the sources, and the merged data sets that the merges make from them. Each
        entity has a <code>sourceId</code> attribute with the id of its data set. Each data set below links to its
        entities in the broker.
        This list is also available as <a href="{{ path('app_sources', {_format: 'json'}) }}">JSON</a>.
    </p>

    {% if histories is null %}
        <p class="text-body-secondary">The import history is not available.</p>
    {% else %}
        <p>
            The data sets are grouped by their model. In each group, the sources come first, then the merged data
            sets. The sources without an import come last. Each source shows its last import, and figures for the
            imports of the last {{ constant('App\\Import\\History\\ImportHistory::DAYS') }} days.
        </p>
    {% endif %}

    {% set models = [] %}
    {% for model in sources|map(source => source.definition.model)|merge(merged|map(dataSet => dataSet.model)) %}
        {% if model not in models %}
            {% set models = models|merge([model]) %}
        {% endif %}
    {% endfor %}

    {% for model in models|sort %}
        {% set modelSources = sources|filter(source => source.definition.model == model) %}
        {% set modelMerged = merged|filter(dataSet => dataSet.model == model) %}
        {% set imported = histories is null ? modelSources : modelSources|filter(source => histories[source.definition.id] is defined) %}
        {% set idle = histories is null ? [] : modelSources|filter(source => histories[source.definition.id] is not defined) %}
        {% set count = modelSources|length + modelMerged|length %}

        <h2 class="source-group">
            {{ model }}
            <span class="source-group-count">{{ count }} {{ count == 1 ? 'data set' : 'data sets' }}</span>
        </h2>

        {% for source in imported %}
            {{ include('source/_source_card.html.twig', {
                source: source,
                history: histories[source.definition.id] ?? null,
                idle: false,
                entities_url: entitiesUrls[source.definition.id],
            }, with_context: false) }}
        {% endfor %}

        {% for dataSet in modelMerged %}
            {{ include('source/_merged_card.html.twig', {
                data_set: dataSet,
                entities_url: entitiesUrls[dataSet.id],
            }, with_context: false) }}
        {% endfor %}

        {% for source in idle %}
            {{ include('source/_source_card.html.twig', {
                source: source,
                history: null,
                idle: true,
                entities_url: entitiesUrls[source.definition.id],
            }, with_context: false) }}
        {% endfor %}
    {% endfor %}
{% endblock %}
