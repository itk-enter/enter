{% extends 'base.html.twig' %}

{% block title %}Sources{% endblock %}

{% block content %}
    <p>
        The data sets in the broker: the sources, and the merged data sets that the merges make from them. Each
        entity has a <code>sourceId</code> attribute with the id of its data set. Each data set below links to its
        entities in the broker.
        This list is also available as <a href="{{ path('app_sources', {_format: 'json'}) }}">JSON</a>.
    </p>

    {% if histories is null %}
        <p class="text-body-secondary">The import history is not available.</p>
        {% set imported = sources %}
        {% set idle = [] %}
    {% else %}
        <p>
            Each source shows its last import, and figures for the imports of the last
            {{ constant('App\\Import\\History\\ImportHistory::DAYS') }} days. Its import history gives the details.
        </p>
        {% set imported = sources|filter(source => histories[source.definition.id] is defined) %}
        {% set idle = sources|filter(source => histories[source.definition.id] is not defined) %}
    {% endif %}

    {% if imported %}
        <h2 class="source-group">Sources</h2>
        {% for source in imported %}
            {{ include('source/_source_card.html.twig', {
                source: source,
                history: histories[source.definition.id] ?? null,
                idle: false,
                entities_url: entitiesUrls[source.definition.id],
            }, with_context: false) }}
        {% endfor %}
    {% endif %}

    {% if merged %}
        <h2 class="source-group">Merged data sets</h2>
        {% for dataSet in merged %}
            <section class="card source-card" id="{{ dataSet.id }}">
                <details>
                    <summary class="source-card-summary">
                        <h3 class="source-card-title">{{ dataSet.title }}</h3>
                        <span class="source-card-status">
                            Merged from {{ dataSet.inputs|length }} {{ dataSet.inputs|length == 1 ? 'data set' : 'data sets' }}
                        </span>
                    </summary>
                    <div class="source-card-body">
                        <dl class="row mb-0 source-facts">
                            <dt class="col-sm-3">Id</dt>
                            <dd class="col-sm-9"><code>{{ dataSet.id }}</code></dd>

                            <dt class="col-sm-3">Description</dt>
                            <dd class="col-sm-9">{{ dataSet.description }}</dd>

                            <dt class="col-sm-3">Merged from</dt>
                            <dd class="col-sm-9">
                                {% for input in dataSet.inputs %}
                                    <code>{{ input }}</code>{% if not loop.last %}, {% endif %}
                                {% else %}
                                    No data set publishes its models.
                                {% endfor %}
                            </dd>

                            <dt class="col-sm-3">Model</dt>
                            <dd class="col-sm-9"><code>{{ dataSet.model }}</code></dd>

                            <dt class="col-sm-3">Context</dt>
                            <dd class="col-sm-9"><a href="{{ dataSet.contextUrl }}">{{ dataSet.contextUrl }}</a></dd>

                            <dt class="col-sm-3">Entities</dt>
                            <dd class="col-sm-9"><a href="{{ entitiesUrls[dataSet.id] }}">{{ entitiesUrls[dataSet.id] }}</a></dd>

                            {% if dataSet.licence %}
                                <dt class="col-sm-3">Licence</dt>
                                <dd class="col-sm-9"><a href="{{ dataSet.licence }}">{{ dataSet.licence }}</a></dd>
                            {% endif %}
                        </dl>
                    </div>
                </details>
            </section>
        {% endfor %}
    {% endif %}

    {% if idle %}
        <h2 class="source-group">Sources without an import</h2>
        {% for source in idle %}
            {{ include('source/_source_card.html.twig', {
                source: source,
                history: null,
                idle: true,
                entities_url: entitiesUrls[source.definition.id],
            }, with_context: false) }}
        {% endfor %}
    {% endif %}
{% endblock %}
