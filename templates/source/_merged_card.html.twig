{#
    One merged data set on /sources. The closed card shows the title and the number of data sets that the merge
    reads. The open card adds the facts about the merged data set.
    Variables: data_set (a MergedDataSet) and entities_url (the broker URL of its entities).
#}
<section class="card source-card" id="{{ data_set.id }}">
    <details>
        <summary class="source-card-summary">
            <h3 class="source-card-title">{{ data_set.title }}</h3>
            <span class="source-card-status">
                Merged from {{ data_set.inputs|length }} {{ data_set.inputs|length == 1 ? 'data set' : 'data sets' }}
            </span>
        </summary>
        <div class="source-card-body">
            <dl class="row mb-0 source-facts">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9"><code>{{ data_set.id }}</code></dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">{{ data_set.description }}</dd>

                <dt class="col-sm-3">Merged from</dt>
                <dd class="col-sm-9">
                    {% for input in data_set.inputs %}
                        <code>{{ input }}</code>{% if not loop.last %}, {% endif %}
                    {% else %}
                        No data set publishes its models.
                    {% endfor %}
                </dd>

                <dt class="col-sm-3">Model</dt>
                <dd class="col-sm-9">
                    {% if data_set.modelUrl %}
                        <a href="{{ data_set.modelUrl }}"><code>{{ data_set.model }}</code></a>
                    {% else %}
                        <code>{{ data_set.model }}</code>
                    {% endif %}
                </dd>

                <dt class="col-sm-3">Context</dt>
                <dd class="col-sm-9"><a href="{{ data_set.contextUrl }}">{{ data_set.contextUrl }}</a></dd>

                <dt class="col-sm-3">Entities</dt>
                <dd class="col-sm-9"><a href="{{ entities_url }}">{{ entities_url }}</a></dd>

                {% if data_set.licence %}
                    <dt class="col-sm-3">Licence</dt>
                    <dd class="col-sm-9"><a href="{{ data_set.licence }}">{{ data_set.licence }}</a></dd>
                {% endif %}
            </dl>
        </div>
    </details>
</section>
