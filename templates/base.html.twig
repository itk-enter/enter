<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Enter{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/favicon.ico') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap">
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="page">
    {% block body %}
        <div class="container-fluid page-main">
        {% block header %}
            {% set title = block('title') %}
            <twig:Heading level="1">{{ title }}</twig:Heading>
        {% endblock %}

        {% block flashes %}
            <twig:Layout:Flashes />
        {% endblock %}

        {% block content %}{% endblock %}
    </div>

    {% block footer %}
        <twig:Layout:PageFooter />
    {% endblock %}
{% endblock %}
</body>
</html>
