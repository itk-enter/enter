{#
    The grey header at the top of a page, with the heading, the breadcrumbs and the content of the details block.
    Variables: breadcrumbs (a list of {label, url} for the pages above this page), current (the name of this page, as
    the last breadcrumb and as the heading) and logo (optional, the URL of an image that replaces the heading). A page
    with a logo has no breadcrumbs. The logo is as high as the heading and the breadcrumbs of the other pages.
#}
<header class="page-header">
    {% if logo|default %}
        <h1 class="page-header-title page-header-logo"><img src="{{ logo }}" alt="{{ current }}"></h1>
    {% else %}
        <h1 class="page-header-title">{{ current }}</h1>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb page-header-breadcrumb">
                {% for crumb in breadcrumbs %}
                    <li class="breadcrumb-item"><a href="{{ crumb.url }}">{{ crumb.label }}</a></li>
                {% endfor %}
                <li class="breadcrumb-item active" aria-current="page">{{ current }}</li>
            </ol>
        </nav>
    {% endif %}
    {% block details %}{% endblock %}
</header>
