upstream scorpio {
    # https://www.getpagespeed.com/server-setup/nginx/nginx-upstream-resolve#basic-example
    zone scorpio_zone 64k;

    # https://www.emmanuelgautier.com/blog/nginx-docker-dns-resolution
    resolver 127.0.0.11;

    server scorpio.local:9090 resolve;
}

# Web pages on other sites can read the open API (CORS): the broker under /ngsi-ld/v1/ and the list of data sets.
# For all other requests the value is empty, and then nginx does not send the header.
map $request_uri $cors_allow_origin {
    ~^/ngsi-ld/v1/(entities|types)(/|\?|$) "*";
    ~^/sources\.json(\?|$) "*";
    default "";
}

server {
    listen ${NGINX_PORT};
    server_name localhost;

    root ${NGINX_WEB_ROOT};

    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    set_real_ip_from 172.16.0.0/16;
    set_real_ip_from 192.168.39.0/24;
    real_ip_recursive on;
    real_ip_header X-Forwarded-For;

    # Proxy NGSI-LD API requests to Scorpio.
    # Allow access to types and entities
    location ~ ^/ngsi-ld/v1/(entities|types)(?:/.+)? {

        # Before some requests from another site, a browser asks with OPTIONS if it may send them (CORS preflight).
        # An example is a request with the Link header of NGSI-LD. The browser sends no login with this question.
        # Thus nginx answers it here, before the login check, and the question does not go to Scorpio.
        # https://developer.mozilla.org/en-US/docs/Glossary/Preflight_request
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $cors_allow_origin always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Accept, Link" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }

        # Allow only GET (and HEAD) and OPTIONS requests for anonymous users. Require authentication for all other
        # methods. nginx applies the configuration inside limit_except to the other methods, and that configuration
        # does not have the "if" above. Thus OPTIONS must be in the list, so that nginx answers it above.
        # https://nginx.org/en/docs/http/ngx_http_core_module.html#limit_except
        limit_except GET OPTIONS {
            auth_basic           "Login required";
            auth_basic_user_file /etc/nginx/auth/.htpasswd;
        }

        # Let web pages on other sites read the answer, and the paging and count headers of NGSI-LD.
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Expose-Headers "Link, NGSILD-Results-Count" always;

        proxy_pass http://scorpio$request_uri;
        proxy_set_header Host $host;
        # Don't pass authorization on to Scorpio.
        proxy_set_header Authorization "";
    }

    # Deny access to all other NGSI-LD endpoints (e.g. subscriptions).
    location ~ ^/ngsi-ld/v1/ {
        deny all;
    }

    location = /cron-metrics {
        # Proxy to supercronic metrics
        proxy_pass http://${NGINX_CRON_METRICS}/metrics;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # try to serve file directly, fallback to index.php
        try_files $uri /index.php$is_args$args;
    }

    # Protect files and directories from prying eyes.
    location ~* \.(engine|inc|install|make|module|profile|po|sh|.*sql|.tar|.gz|.bz2|theme|twig|tpl(\.php)?|xtmpl|yml)(~|\.sw[op]|\.bak|\.orig|\.save)?$|^(\.(?!well-known).*|Entries.*|Repository|Root|Tag|Template|composer\.(json|lock)|web\.config)$|^#.*#$|\.php(~|\.sw[op]|\.bak|\.orig|\.save)$ {
        deny all;
        return 404;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_buffers 16 32k;
        fastcgi_buffer_size 64k;
        fastcgi_busy_buffers_size 64k;

        fastcgi_pass ${NGINX_FPM_SERVICE};
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;

        # Let web pages on other sites read /sources.json. The value is empty for all other pages.
        add_header Access-Control-Allow-Origin $cors_allow_origin always;

        internal;
    }

    location ~ \.php$ {
        return 404;
    }

    # Send log message to files symlinked to stdout/stderr.
    error_log /dev/stderr;
    access_log /dev/stdout main;
}
